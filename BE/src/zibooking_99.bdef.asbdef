managed implementation in class zbp_ibooking_99 unique;
strict ( 2 );
with draft;

define behavior for ZIBOOKING_99 alias BookingHeader
persistent table ztbooking_99
draft table ztbooking__d_99
lock master
total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
early numbering
{
  create;
  update;
  delete;
  field ( readonly ) BookingId, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory ) CustomerId, BookingDate;
  association _bookingItem { create; with draft; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare { }

  mapping for ztbooking_99
    {
      BookingId          = booking_id;
      CustomerId         = customer_id;
      BookingDate        = booking_date;
      Description        = description;
      TotalPrice         = total_price;
      CurrencyCode       = currency_code;
      OverallStatus      = overall_status;
      ConfirmFlag        = confirm_flag;
      Priority           = priority;
      CustomerRating     = customer_rating;
      CompletionPct      = completion_pct;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}

define behavior for ZIBOOKINGITEM_99 alias BookingItem
persistent table ztbookingitem_99
draft table ztbkitem_d_99
lock dependent by _bookingHeader
authorization dependent by _bookingHeader
etag master LocalLastChangedAt
{
  update;
  delete;
  field ( readonly ) BookingId;
  field ( readonly : update ) ItemId;
  association _bookingHeader { with draft; }
  mapping for ztbookingitem_99
    {
      BookingId          = booking_id;
      ItemId             = item_id;
      ProductId          = product_id;
      Quantity           = quantity;
      QuantityUnit       = quantity_unit;
      ItemPrice          = item_price;
      CurrencyCode       = currency_code;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}