projection;
strict ( 2 );
use draft;

define behavior for ZCBOOKING_99 alias BookingHeader
{
  use create;
  use update;
  use delete;

  use association _bookingItem { create; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for ZCBOOKINGITEM_99 alias BookingItem
{
  use update;
  use delete;

  use association _bookingHeader;
}